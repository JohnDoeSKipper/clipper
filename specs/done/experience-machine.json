 "script": [
  {
   "text": "Imagine a machine that gives you any life you want."
  },
  {
   "text": "Fame. Love. Adventure. It all feels completely real.",
   "gap": 0.45
  },
  {
   "text": "There's one catch."
  },
  {
   "text": "Once you plug in, you'll never know it's fake."
  },
  {
   "text": "And you can never come back.",
   "gap": 0.55
  },
  {
   "text": "Would you plug in?",
   "gap": 0.6
  },
  {
   "text": "Most people say no."
  },
  {
   "text": "But if happiness is all that matters, why not?",
   "gap": 0.55
  },
  {
   "text": "Maybe we want more than feeling good."
  },
  {
   "text": "Maybe we want it to be real."
  }
 ],
