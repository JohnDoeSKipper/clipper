 "script": [
  {
   "text": "Van Gogh painted the most famous night sky in history... in broad daylight.",
   "gap": 0.7
  },
  {
   "text": "In June 1889, he was living in an asylum in the south of France.",
   "say": "In June eighteen eighty-nine, he was living in an asylum in the south of France."
  },
  {
   "text": "This was the view from his bedroom window. But he wasn't allowed to paint there, so he painted it from memory.",
   "gap": 0.75
  },
  {
   "text": "That brightest star? It's Venus. He had watched it rise before dawn.",
   "gap": 0.75
  },
  {
   "text": "The village wasn't in his view. He added it, with a steeple that looks like the churches of his Dutch homeland.",
   "gap": 0.75
  },
  {
   "text": "And the dark cypress, a tree planted in graveyards, climbs from the earth to the stars."
  },
  {
   "text": "He considered this painting a failure."
  }
 ],
